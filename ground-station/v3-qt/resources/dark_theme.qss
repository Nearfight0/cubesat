/* ============================================================
   Mission: Kripto — CubeSat Ground Station
   Dark Theme Stylesheet
   Accent: #0078D4  |  BG: #1A1A1A  |  Surface: #252525
   ============================================================ */

/* ── Global ──────────────────────────────────────────────── */
QWidget {
    background-color: #1A1A1A;
    color: #E0E0E0;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #1A1A1A;
}

/* ── Labels ──────────────────────────────────────────────── */
QLabel {
    color: #E0E0E0;
    background-color: transparent;
}

/* ── Group Boxes ─────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    font-weight: bold;
    color: #CCCCCC;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #0078D4;
    font-size: 9pt;
}

/* ── Buttons ─────────────────────────────────────────────── */
QPushButton {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 5px 14px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #005FA3;
    border-color: #005FA3;
}

QPushButton:disabled {
    background-color: #222222;
    color: #555555;
    border-color: #2A2A2A;
}

/* Danger button (Trigger Separation) */
QPushButton#dangerButton {
    background-color: #7B1F1F;
    border-color: #E74C3C;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#dangerButton:hover {
    background-color: #E74C3C;
    border-color: #E74C3C;
}

QPushButton#dangerButton:pressed {
    background-color: #C0392B;
}

/* ── ComboBox ────────────────────────────────────────────── */
QComboBox {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #0078D4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    selection-background-color: #0078D4;
    outline: none;
}

/* ── Line Edit ───────────────────────────────────────────── */
QLineEdit {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
}

QLineEdit:focus {
    border-color: #0078D4;
}

QLineEdit::placeholder {
    color: #666666;
}

/* ── Text Edit ───────────────────────────────────────────── */
QTextEdit {
    background-color: #141414;
    color: #D0D0D0;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    font-family: "Consolas", "Courier New", monospace;
}

/* ── Tab Widget ──────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2A2A2A;
    border-top: none;
    background-color: #1A1A1A;
}

QTabBar::tab {
    background-color: #252525;
    color: #AAAAAA;
    border: 1px solid #2A2A2A;
    border-bottom: none;
    padding: 6px 18px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border-bottom: 2px solid #0078D4;
}

QTabBar::tab:hover:!selected {
    background-color: #2D2D2D;
    color: #E0E0E0;
}

/* ── Dock Widget ─────────────────────────────────────────── */
QDockWidget {
    color: #E0E0E0;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #252525;
    padding: 6px 8px;
    border-bottom: 1px solid #3A3A3A;
    font-weight: bold;
    color: #0078D4;
}

/* ── Scroll Bars ─────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #1A1A1A;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0078D4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1A1A1A;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0078D4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Progress Bar ────────────────────────────────────────── */
QProgressBar {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    text-align: center;
    color: #FFFFFF;
    font-size: 9pt;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 3px;
}

/* ── Status Bar ──────────────────────────────────────────── */
QStatusBar {
    background-color: #141414;
    border-top: 1px solid #2A2A2A;
    color: #AAAAAA;
    font-size: 9pt;
}

QStatusBar QLabel {
    padding: 0 8px;
    color: #AAAAAA;
}

/* ── Message Box ─────────────────────────────────────────── */
QMessageBox {
    background-color: #252525;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ── Tooltips ────────────────────────────────────────────── */
QToolTip {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #0078D4;
    padding: 4px;
    border-radius: 3px;
}

/* ── Separator / Frame ───────────────────────────────────── */
QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #3A3A3A;
    background-color: #3A3A3A;
    border: none;
    max-height: 1px;
}

/* ── Splitter ────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2A2A2A;
}

QSplitter::handle:hover {
    background-color: #0078D4;
}

